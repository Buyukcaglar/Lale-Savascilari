// Windows resources of Lale64.exe: the program icon (generated by
// tools/genicon.py from assets/icon/lale_icon_source.png) and the version
// shown in Explorer's file properties (keep in step with LALE_VERSION in
// src/platform/about.c).
1 ICON "../gen/lale.ico"

// The application manifest (UTF-8 file names): resource type 24 = RT_MANIFEST.
1 24 "lale.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription",  "Istanbul Efsaneleri: Lale Savascilari 64bit"
      VALUE "ProductName",      "Istanbul Efsaneleri: Lale Savascilari 64bit"
      VALUE "FileVersion",      "1.0"
      VALUE "ProductVersion",   "1.0"
      VALUE "CompanyName",      "Onur BUYUKCAGLAR"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Onur BUYUKCAGLAR (port code, MIT)"
      VALUE "OriginalFilename", "Lale64.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
