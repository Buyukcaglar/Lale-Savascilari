{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Lale Savaşçıları 64bit (Lale64)",
  "repo": "Buyukcaglar/Lale-Savascilari",
  "inputs": [
    {
      "id": "game",
      "label": "Your copy of İstanbul Efsaneleri: Lale Savaşçıları: the game CD's image (.iso, or .cue with its .bin beside it), or the folder of the CD or of the 2005 release (the one that holds 3D.CKD).",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "iso",
            "cue"
          ]
        },
        {
          "type": "folder"
        }
      ],
      "check": {
        "file": "3D.CKD",
        "iso9660": "3D.CKD"
      }
    }
  ],
  "start": {
    "program": [
      "Lale64.exe",
      "Lale64.app"
    ],
    "args": [
      "--source",
      "{input:game}"
    ]
  },
  "saves": [
    "{install}/SAVE"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/SAVE"
      }
    ]
  },
  "settings": [
    {
      "id": "edition",
      "label": "Edition",
      "in": "args",
      "help": "Which edition of the game plays. Automatic picks the 1996 CD edition when your copy is a disc with music tracks, otherwise the 2005 edition.",
      "choices": [
        {
          "label": "Automatic",
          "args": []
        },
        {
          "label": "CD edition (1996)",
          "args": [
            "--edition",
            "cd"
          ]
        },
        {
          "label": "2005 edition",
          "args": [
            "--edition",
            "2005"
          ]
        }
      ]
    },
    {
      "id": "video",
      "label": "Videos",
      "in": "args",
      "help": "What the game's videos start as when its VIDEO folder holds upscaled copies. Ctrl+V switches while you play.",
      "choices": [
        {
          "label": "Game's option",
          "args": []
        },
        {
          "label": "Upscaled (4K)",
          "args": [
            "--video",
            "4k"
          ]
        },
        {
          "label": "Original",
          "args": [
            "--video",
            "original"
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "saves",
      "label": "Saves",
      "help": "Open the folder your saves are in.",
      "open": "saves"
    }
  ],
  "exit_codes": {
    "1": "It couldn't start: your copy of the game couldn't be set up. Pick your game folder again on the game's page."
  },
  "system": {
    "windows": {
      "version": "10"
    },
    "macos": {
      "version": "11"
    }
  }
}
