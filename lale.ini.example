; lale.ini - port options (copy to lale.ini next to the program;
; the macOS app also reads ~/Library/Application Support/Lale64/lale.ini)
; The command line overrides this file.  docs/INSTALL.md explains the folders.

; What to take the game from at this start: the game CD's drive, a disc image
; (.cue, .iso, .chd), a folder, or the 2005 release as .zip / .7z / .rar.
; Not needed once the game is in DATA; without it the program looks beside
; itself and in the CD drives, then asks.
source =

; auto: the CD edition (1996) when DATA/LALE.CHD is a disc with audio tracks,
; else the 2005 edition.  cd | 2005 decide otherwise (docs/EDITIONS.md).
edition = auto

; Where DATA, SAVE and VIDEO are (default: beside the executable)
base_dir =

; What videos start as when VIDEO holds upscaled copies: 4k | original.
; Ctrl+V switches while the game runs.
video = 4k

; ---- development ---------------------------------------------------------------
; The game straight from a folder of the original's files (no DATA / SAVE)
game_dir =
; with game_dir and edition = cd: the disc (.cue, .chd)
cd_image =
; old name of edition = cd
cd_music = 0
